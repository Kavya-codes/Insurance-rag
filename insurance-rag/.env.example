# Required for answer generation and LLM-as-judge faithfulness evaluation
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini model identifiers
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_JUDGE_MODEL="gemini-4-hydrogen"

# Retrieval models (downloaded via sentence-transformers on first ingest/query)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Paths (relative to project root or absolute)
RAW_DATA_DIR="data/raw"
INDEX_DIR="data/index"
GOLDEN_PATH="data/golden/golden.jsonl"
REPORTS_DIR="reports"

# Chunking & retrieval parameters
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_RRF=20
TOP_K_RETURN=5
RRF_K=60
ABSTENTION_THRESHOLD=0.30

# FastAPI server
API_HOST="0.0.0.0"
API_PORT=8000
